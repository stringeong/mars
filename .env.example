# 로컬 개발은 development, 운영 배포는 production
MARS_ENV=development

# 운영에서는 32자 이상의 임의 값이 필수이며 아래 예시 값은 거부됨
MARS_SECRET_KEY=change-this-to-a-long-random-secret

# 쉼표로 구분. wildcard(*)는 금지되며 운영 Origin은 HTTPS만 허용
MARS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hostname만 쉼표로 구분. wildcard(*) 금지
MARS_ALLOWED_HOSTS=localhost,127.0.0.1

# 호스트에 공개할 포트
MARS_SERVER_PORT=8000
MARS_WEB_PORT=5173


# 호스트에서 실행 중인 Ollama에 접근
OLLAMA_URL=http://host.docker.internal:11434
MARS_DEFAULT_MODEL=gemma3:4b

MARS_TOKEN_EXPIRE_MIN=720
MARS_HEARTBEAT_TIMEOUT=30

# Docker Worker가 접근하도록 허용할 기본 호스트 폴더
MARS_WORKER_SHARED_DIR=./worker/shared

# production override(docker-compose.prod.yml) 전용
# MARS_HTTP_PORT=80
# MARS_HTTPS_PORT=443
# MARS_TLS_CERT_FILE=/etc/letsencrypt/live/mars.example.com/fullchain.pem
# MARS_TLS_KEY_FILE=/etc/letsencrypt/live/mars.example.com/privkey.pem
